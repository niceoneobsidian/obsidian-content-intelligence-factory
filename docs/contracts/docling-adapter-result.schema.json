{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://niceoneobsidian.github.io/ocif/contracts/docling-adapter-result-0.1.0.schema.json",
  "title": "Docling Adapter Result (internal, not an OCIF envelope)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "processor_id", "processor_version",
    "artifact_sha256", "artifact_size_bytes", "media_type",
    "extraction_status", "markdown", "page_count", "warnings", "error_code"
  ],
  "properties": {
    "contract_version": {"const": "0.1.0"},
    "processor_id": {"type": "string", "minLength": 1},
    "processor_version": {"type": "string", "minLength": 1},
    "artifact_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "artifact_size_bytes": {"type": "integer", "minimum": 1},
    "media_type": {"const": "application/pdf"},
    "extraction_status": {"enum": ["success", "partial", "failed"]},
    "markdown": {"type": ["string", "null"]},
    "page_count": {"type": ["integer", "null"], "minimum": 0},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "error_code": {"type": ["string", "null"]}
  }
}
